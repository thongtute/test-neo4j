# Đổi tên file này thành .env nếu muốn đổi cấu hình (không bắt buộc)

# Mật khẩu Neo4j (tối thiểu 8 ký tự). Nếu đổi sau khi đã chạy lần đầu,
# phải xoá volume cũ: docker compose down -v
NEO4J_PASSWORD=password123

# Hai đoạn được coi là "giống nhau" (nối SIMILAR_TO) nếu dấu vân tay ảnh
# khác nhau không quá N bit / 64. 0 = chỉ nối khi giống hệt, -1 = tắt tính năng.
SIMILARITY_MAX_DISTANCE=8
